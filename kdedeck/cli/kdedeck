#!/usr/bin/env python3
import os
import sys
import subprocess
import signal
import time

SCRIPT_PATH = os.path.realpath(__file__)
CLI_DIR = os.path.dirname(SCRIPT_PATH)
KDEDECK_DIR = os.path.dirname(CLI_DIR)
PROJECT_DIR = os.path.dirname(KDEDECK_DIR)

VENV_PYTHON = os.path.join(PROJECT_DIR, "venv", "bin", "python3")
SERVER_MAIN = os.path.join(PROJECT_DIR, "kdedeck", "server", "main.py")
PID_FILE = os.path.expanduser("~/.config/kdedeck/kdedeck.pid")
SYSTEMD_USER_DIR = os.path.expanduser("~/.config/systemd/user")
AUTOSTART_DIR = os.path.expanduser("~/.config/autostart")

def get_running_pid():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            # Check if process is alive
            os.kill(pid, 0)
            return pid
        except (ValueError, OSError):
            pass
    return None

def start_server():
    pid = get_running_pid()
    if pid:
        print(f"✅ KdeDeck server is already running (PID: {pid})")
        return

    print("🚀 Starting KdeDeck background daemon...")
    env = os.environ.copy()
    env["PYTHONPATH"] = PROJECT_DIR

    proc = subprocess.Popen(
        [VENV_PYTHON, SERVER_MAIN],
        cwd=PROJECT_DIR,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )

    os.makedirs(os.path.dirname(PID_FILE), exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(proc.pid))

    print(f"✅ KdeDeck started successfully! (PID: {proc.pid})")
    print("📱 Open http://localhost:8484 in your browser or phone!")

def stop_server():
    pid = get_running_pid()
    if not pid:
        print("ℹ️ KdeDeck is not currently running.")
        return

    print(f"🛑 Stopping KdeDeck (PID: {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(1)
    except Exception as e:
        print(f"Error stopping process: {e}")

    if os.path.exists(PID_FILE):
        os.remove(PID_FILE)
    print("✅ KdeDeck stopped.")

def print_status():
    pid = get_running_pid()
    if pid:
        try:
            res = subprocess.run(f"ps -o rss= -p {pid}", shell=True, capture_output=True, text=True)
            rss_kb = int(res.stdout.strip() or 0)
            ram_mb = round(rss_kb / 1024, 2)
            print(f"🟢 KdeDeck Status: RUNNING (PID: {pid}) | RAM Usage: ~{ram_mb} MB")
        except Exception:
            print(f"🟢 KdeDeck Status: RUNNING (PID: {pid})")
    else:
        print("🔴 KdeDeck Status: STOPPED")

def install_cli():
    bin_dir = os.path.expanduser("~/.local/bin")
    os.makedirs(bin_dir, exist_ok=True)
    target = os.path.join(bin_dir, "kdedeck")
    if os.path.lexists(target):
        os.remove(target)
    os.symlink(SCRIPT_PATH, target)
    print(f"✅ Symlinked 'kdedeck' executable to {target}")
    print("Now you can run 'kdedeck start', 'kdedeck status', 'kdedeck stop' from any terminal!")

def enable_autostart():
    os.makedirs(SYSTEMD_USER_DIR, exist_ok=True)
    os.makedirs(AUTOSTART_DIR, exist_ok=True)

    # Write systemd service file
    service_content = f"""[Unit]
Description=KdeDeck Stream Deck Server
After=network.target

[Service]
Type=simple
WorkingDirectory={PROJECT_DIR}
Environment="PYTHONPATH={PROJECT_DIR}"
ExecStart={VENV_PYTHON} {SERVER_MAIN}
Restart=always

[Install]
WantedBy=default.target
"""
    service_path = os.path.join(SYSTEMD_USER_DIR, "kdedeck.service")
    with open(service_path, "w") as f:
        f.write(service_content)

    # Enable via systemctl
    subprocess.run("systemctl --user daemon-reload", shell=True)
    subprocess.run("systemctl --user enable kdedeck.service", shell=True)

    # Desktop autostart fallback
    desktop_content = f"""[Desktop Entry]
Type=Application
Name=KdeDeck
Exec={VENV_PYTHON} {SERVER_MAIN}
X-KDE-autostart-after=panel
"""
    desktop_path = os.path.join(AUTOSTART_DIR, "kdedeck.desktop")
    with open(desktop_path, "w") as f:
        f.write(desktop_content)

    print("✅ KdeDeck autostart enabled successfully for KDE Plasma boot!")

def main():
    if len(sys.argv) < 2:
        print("Usage: kdedeck {start|stop|status|enable-autostart|install-cli}")
        sys.exit(1)

    cmd = sys.argv[1].lower()
    if cmd == "start":
        start_server()
    elif cmd == "stop":
        stop_server()
    elif cmd == "status":
        print_status()
    elif cmd == "enable-autostart":
        enable_autostart()
    elif cmd == "install-cli":
        install_cli()
    else:
        print(f"Unknown command: {cmd}")

if __name__ == "__main__":
    main()
