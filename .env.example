# Optional standalone-daemon TLS files. Both are required when LAN mode is enabled.
# Keep real certificates and keys outside version control.
KDEDECK_TLS_CERT_FILE=./secrets/server.crt
KDEDECK_TLS_KEY_FILE=./secrets/server.key

# Optional JSON registry of applications the daemon may launch.
KDEDECK_APPROVED_APPS={}

# Optional durable bearer-session metadata. Disabled unless explicitly set to
# required; storage or recovery failures then stop the daemon rather than
# silently falling back to in-memory sessions.
KDEDECK_SESSION_PERSISTENCE=disabled

# Optional embedded-server pairing token. Use a random value with at least 16 characters.
DART_SERVER_PAIRING_TOKEN=replace-with-a-random-pairing-token
